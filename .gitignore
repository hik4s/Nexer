# Nexer — regras para clonar e executar sem compartilhar estado local
# Versao: 2026-10-14
# IMPORTANTE: este arquivo nao remove itens JA rastreados pelo Git.
# Scripts, lockfiles, migrations, assets, receitas e configuracoes de exemplo
# devem continuar versionados para uma instalacao reproduzivel.

# Segredos e configuracoes locais
.env
.env.*
!.env.example
!.env.sample
.streamlit/secrets.toml
*.p12
*.pfx
*.key
*.pem

# Dependencias instaladas na maquina (recriar com pip/npm ci)
venv/
.venv/
env/
ENV/
node_modules/
.pnpm-store/
.npm/
.yarn/cache/

# Cache, cobertura, compilados Python
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage/
*.tsbuildinfo

# Bases SQLite e estado local (as migrations Python DEVEM ir ao Git)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# O arquivo data/.gitkeep pode ser versionado para preservar a pasta vazia.

# Relatorios extraidos, sessoes, traces e registros de execucao
downloads/
logs/
screenshots/
playwright-report/
test-results/
blob-report/
temp/
tmp/
status/status.json
status/*.pid
status/*.tmp
status/encerrar_streamlit.json
*.log
*.trace
*.har
*.webm
*.zip.part
*.crdownload
*.partial

# Saidas de build/teste geradas (NAO ignorar arquivos de definicao *.spec)
build/
dist/
.vite/
.next/
.astro/

# IDE, SO e atalhos locais
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.atalho_criado
*.lnk

# Backups locais e arquivos temporarios do Office
*.bak
*.backup
*.old
~$*

# NAO ignorar: *.exe por regra generica, *.spec, package-lock.json,
# apps/backend/alembic/versions/*.py, assets, apps/frontend/public e README.
# Um executavel legado presente no repo NAO substitui instalar o nucleo novo.
